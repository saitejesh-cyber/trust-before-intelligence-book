    style C1 fill:#ffebee,stroke:none,color:#b71c1c,rx:10,ry:10
    style D1 fill:#ffebee,stroke:none,color:#b71c1c,rx:10,ry:10

    %% 🟢 TRUSTED / AGENT ERA
