    style A2 fill:#f9f9f9,stroke:none,color:#000000,rx:10,ry:10
    style B2 fill:#f9f9f9,stroke:none,color:#000000,rx:10,ry:10
    style C2 fill:#f9f9f9,stroke:none,color:#000000,rx:10,ry:10
