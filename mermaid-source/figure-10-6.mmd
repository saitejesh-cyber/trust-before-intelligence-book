
graph LR
    subgraph STATUS["STATUS INDICATORS"]
        direction TB
        GREEN["On Track<br/>Continue"]
        YELLOW["At Risk<br/>Assign Owner"]
        RED["Blocked<br/>Escalate 24h"]
    end
    
    subgraph ACTIONS["RESPONSE FLOW"]
        direction TB
        R1["Daily Check-ins"]
        R2["Mitigation Plan"]
        RESOLVED{{"Resolved?"}}
        R1 --> RESOLVED
        R2 --> RESOLVED
    end
    
    subgraph OUTCOMES[" "]
        direction TB
        CONTINUE["Proceed to Next Week"]
        ESCALATE["Leadership Escalation"]
    end
    
    Copyright["© 2025 Colaberry Inc."]
    
    GREEN --> CONTINUE
    YELLOW --> R1
    YELLOW --> R2
    RED --> ESCALATE
    RESOLVED -->|"Yes"| CONTINUE
    RESOLVED -->|"No"| ESCALATE
    
    style STATUS fill:#7FD5E8,stroke:#7FD5E8,stroke-width:1px,color:#0D0D0D,rx:20,ry:20
    style ACTIONS fill:#7FD5E8,stroke:#7FD5E8,stroke-width:1px,color:#0D0D0D,rx:20,ry:20
    style OUTCOMES fill:none,stroke:none
    style GREEN fill:#7FD5E8,stroke:none,color:#0D0D0D,rx:10,ry:10
    style YELLOW fill:#7FD5E8,stroke:none,color:#0D0D0D,rx:10,ry:10
    style RED fill:#EB898B,stroke:none,color:#0D0D0D,rx:10,ry:10
    style R1 fill:#7FD5E8,stroke:none,color:#0D0D0D,rx:10,ry:10
    style R2 fill:#7FD5E8,stroke:none,color:#0D0D0D,rx:10,ry:10
    style RESOLVED fill:#4478A6,stroke:none,color:#ffffff,rx:10,ry:10
    style CONTINUE fill:#14D793,stroke:#14D793,stroke-width:1px,color:#0D0D0D,rx:20,ry:20
    style ESCALATE fill:#EB898B,stroke:#EB898B,stroke-width:1px,color:#0D0D0D,rx:20,ry:20
    style Copyright fill:none,stroke:none,color:#0D0D0D

