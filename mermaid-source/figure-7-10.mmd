graph TB
    NL["<b>User Query:</b><br/><b>Show my doctor's</b><br/><b>availability next week</b>"]
    
    NL --> L4["<b>Layer 4: Intelligence</b><br/><b>Receives raw natural language</b>"]
    
    subgraph PHASE1["<b>Phase 1: UNDERSTAND</b>"]
        P1["<b>LLM Analysis:</b><br/><b>Parse • Extract • Plan</b>"]
    end
    
    subgraph PHASE2["<b>Phase 2: RESOLVE</b>"]
        P2["<b>Call Layer 3:</b><br/><b>resolve_entity • lookup_glossary</b>"]
    end
    
    subgraph PHASE3["<b>Phase 3: EXECUTE</b>"]
        P3A["<b>Retrieve Context:</b><br/><b>Query data • Apply ABAC</b>"]
        P3B["<b>Validate Quality:</b><br/><b>NDCG@5 >0.8</b>"]
    end
    
    CLARIFY["<b>Clarification</b><br/><b>Confidence < 0.90</b>"]
    
    RESULT["<b>Natural Response:</b><br/><b>Dr. Martinez has 5 openings</b>"]
    
    L4 --> P1
    P1 --> P2
    P2 --> P3A
    P3A --> P3B
    P3B --> RESULT
    
    P1 -.->|<b>Low confidence</b>| CLARIFY
    P3B -.->|<b>Quality fail</b>| CLARIFY
    
    style L4 fill:#14D793,stroke:#14D793,stroke-width:1px,color:#0D0D0D,rx:20,ry:20
    style PHASE1 fill:#14D793,stroke:#14D793,stroke-width:1px,color:#0D0D0D,rx:20,ry:20
    style PHASE2 fill:#14D793,stroke:#14D793,stroke-width:1px,color:#0D0D0D,rx:20,ry:20
    style PHASE3 fill:#14D793,stroke:#14D793,stroke-width:1px,color:#0D0D0D,rx:20,ry:20
    style P1 fill:#14D793,stroke:none,color:#0D0D0D,rx:10,ry:10
    style P2 fill:#14D793,stroke:none,color:#0D0D0D,rx:10,ry:10
    style P3A fill:#14D793,stroke:none,color:#0D0D0D,rx:10,ry:10
    style P3B fill:#14D793,stroke:none,color:#0D0D0D,rx:10,ry:10
    style RESULT fill:#14D793,stroke:#14D793,stroke-width:1px,color:#0D0D0D,rx:20,ry:20
    style CLARIFY fill:#EB898B,stroke:#EB898B,stroke-width:1px,color:#0D0D0D,rx:20,ry:20
